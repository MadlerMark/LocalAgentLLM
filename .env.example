# Local model endpoint (Ollama OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MODEL=qwen3:8b
FALLBACK_MODEL=qwen2.5-coder:1.5b
SUPERVISOR_MODEL=qwen2.5-coder:1.5b
SUPERVISOR_FALLBACK_MODEL=qwen3:8b
TEMPERATURE=0
LLM_TIMEOUT_S=60

# App config
HOST=127.0.0.1
PORT=8000
MAX_AGENT_STEPS=8
MAX_TOOL_ERRORS=3
ENABLE_SUPERVISOR=true
COMMAND_TIMEOUT_S=20
# In WSL this should be a Linux path like /mnt/c/Users/...
WORKSPACE_ROOT=/mnt/c/Users/madle/Documents/GitHub/LocalAgentLLM
